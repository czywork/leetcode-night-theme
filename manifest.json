{
  "manifest_version": 3,
  "name": "深夜护眼 · 力扣夜间主题",
  "version": "1.0.0",
  "description": "给力扣（leetcode.cn）加上暖色深夜护眼主题：低蓝光、柔和不刺眼，代码高亮同步换色。",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "深夜护眼 · 力扣夜间主题",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://leetcode.cn/*",
    "https://*.leetcode.cn/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://leetcode.cn/*", "https://*.leetcode.cn/*"],
      "js": ["src/content.js"],
      "css": ["src/theme.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-theme": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "开启/关闭深夜护眼主题"
    }
  }
}